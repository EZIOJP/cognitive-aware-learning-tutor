# Copy to .env and adjust (see docs/DEPENDENCIES.md)

# --- LAN / WiFi (optional — frontend auto-detects when opened via http://YOUR_IP:5173) ---
# Backend already binds 0.0.0.0:8000 via run scripts. Allow ports 5173 + 8000 in firewall.
# VITE_API_URL=http://192.168.1.10:8000
# VITE_VOCAB_API_BASE=http://192.168.1.10:8000/api/vocab
# VITE_WS_URL=ws://192.168.1.10:8000/ws/eeg
# FACE_TRACKER_STATUS_URL=http://localhost:8000/api/vocab/face/status

# --- Auth & app ---
JWT_SECRET=change-this-in-production
DEV_MODE=true
APP_ENV=development
CORS_ORIGINS=*

# --- Database (SQLite default; Postgres later) ---
# DATABASE_URL=sqlite:///./data/vocab_app.db

# --- Vocab seed ---
SEED_WORDS_ON_STARTUP=true
WORDS_SOURCE=auto

# --- EEG: UDP :5005 + WebSocket /ws/eeg (0 = frontend simulation only) ---
EEG_ENABLED=0

# --- Math OCR (TexTeller ONNX, CPU — optional) ---
# TEXTELLER_MODEL_ID=Ji-Ha/TexTeller3-ONNX-dynamic
# TEXTELLER_CACHE_DIR=models/texteller

# --- NVIDIA NIM (Gemma AI Review + vision teacher — optional) ---
# NIM_API_KEY=nvapi-...  # heavy-tier NIM chain + math OCR vision (integrate.api.nvidia.com)
# NIM_MODEL=google/gemma-4-31b-it
# NIM_VISION_MODEL=nvidia/nemotron-nano-vl-8b-v1
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Local AI (optional — Ollama, LM Studio, or Google Gemini) ---
OLLAMA_ENABLED=1
# lmstudio | ollama | openai | gemini
LLM_PROVIDER=lmstudio
OLLAMA_URL=http://127.0.0.1:1234
LMSTUDIO_URL=http://127.0.0.1:1234
# Real Ollama daemon (separate from LM Studio) — port 11434
OLLAMA_NATIVE_URL=http://127.0.0.1:11434
# Load this model in LM Studio (Local Server → Start Server)
OLLAMA_MODEL=google/gemma-4-e4b
LLM_API_KEY=lm-studio
# Gemini (cloud — requests go to Google, not LM Studio):
# LLM_PROVIDER=gemini
# OLLAMA_MODEL=gemini-2.0-flash
# LLM_API_KEY=your-key-from-aistudio.google.com
LLM_MAX_TOKENS=8192
# Tier chains — edit data/llm_tiers.json or override via env (see docs/LLM_GATEWAY.md)
LLM_DEFAULT_TIER=medium
# hybrid-free = Groq/Cerebras/Gemini cloud + LM Studio local fallback (see CALT Free LLM APIs.pdf)
LLM_ROUTE_PROFILE=hybrid-free
# Free cloud keys (no credit card) — add any you have; gateway skips missing keys
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=
LLM_CLOUD_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_OPENROUTER_API_KEY=
LLM_OPENROUTER_SITE_URL=
LLM_OPENROUTER_APP_NAME=CALT
# OpenRouter advanced (see docs/LLM_GATEWAY.md)
LLM_OPENROUTER_METADATA=1
LLM_OPENROUTER_RESPONSE_CACHE=1
LLM_OPENROUTER_ZDR=0
LLM_OPENROUTER_MAX_PRICE_PROMPT=0.001
LLM_OPENROUTER_MAX_PRICE_COMPLETION=0.002
LLM_OPENROUTER_MAX_LATENCY_LIGHT=2.0
LLM_OPENROUTER_MAX_LATENCY_MEDIUM=8.0
TAVILY_API_KEY=
LLM_HEAVY_DAILY_SOFT_CAP=50

# --- 9Router (optional — local AI gateway for Cursor + CALT; see docs/9ROUTER_SETUP.md) ---
# Install: scripts\9router\install_9router.bat  |  Start: scripts\9router\start_9router.bat
# Dashboard: http://localhost:20128/dashboard  |  API: http://localhost:20128/v1
# Free 2026: Kiro (kr/) + OpenCode Free (oc/) — create combo "free-forever" in dashboard
# Copy API key into LLM_API_KEY; optional: copy data/llm_tiers.9router.example.json -> data/llm_tiers.json
# Route profiles: copy data/llm_routes.hybrid.example.json -> data/llm_routes.json

# Corpus grounded notes (hybrid RAG writer); 1 = cite textbook + lecture chunks
CORPUS_GROUNDED_NOTES=1
# OpenAI-compatible fallback (vLLM, older LM Studio):
# LLM_PROVIDER=openai
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_VISION_MODEL=llava

# --- Python focus mirror → hub (paste JWT after login) ---
FACE_TRACKER_TOKEN=

# --- Google Calendar (push planner → GCal → phone → Amazfit) ---
# See docs/GOOGLE_CALENDAR_AMAZFIT.md
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/planner/google-calendar/callback
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_REFRESH_TOKEN=

# --- Morning gate (Bible → plan confirm → open) ---
# MORNING_GATE=1
# Plan confirm only between MORNING_PLAN_START and MORNING_PLAN_EOD (local time).
# Window start = max(bible_completed_at, MORNING_PLAN_START). After EOD without confirm → day opens soft.
# MORNING_PLAN_START=05:00
# MORNING_PLAN_EOD=23:59
# Explicit “Draft auto plan” / POST /morning-plan/auto-draft only — gate refreshes never write blocks.
# MORNING_AUTO_PLAN=1
# Auto-confirm the draft inside the plan window only (default off — keep Confirm CTA).
# MORNING_AUTO_PLAN_CONFIRM=0

# --- Browser day modes (SelfTracker extensions poll distraction-gate) ---
# After plan confirm, daytime default is STUDY (YouTube blocked; Scaler/Colab allowed — not auto-opened).
# Free only: planner break/leisure blocks, after BROWSER_FREE_AFTER, or tray “Free time…” (same PIN as exit).
# BROWSER_FREE_AFTER=21:00
# BROWSER_FREE_OVERRIDE_MINUTES=90

# --- Desktop tracker persistence / exit (self-control) ---
# TRACKER_EXIT_PIN=       # if unset, tray Confirm exit + Free time + stop/restart/uninstall bats need phrase: I AM DONE TRACKING
# TRACKER_PERSIST_PROTECT=1  # while Armed, re-add HKCU Run every few minutes
# TRACKER_NO_TRAY=0
# Install: scripts\install_tracker_persistence.bat
# Uninstall: scripts\uninstall_tracker_persistence.bat

# --- Frontend (optional .env.local — Vite exposes VITE_* only) ---
# VITE_API_BASE=http://localhost:8000
# VITE_VOCAB_API_BASE=http://localhost:8000/api/vocab
