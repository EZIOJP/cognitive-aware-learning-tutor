#pragma once
/**
 * Copy to secrets.h and edit for your network / wiring.
 *   copy secrets.h.example secrets.h
 *
 * NEVER commit secrets.h (WiFi password).
 * flash_eeg.bat / ensure_secrets.py create secrets.h automatically.
 */

// --- WiFi (2.4 GHz only) ---
#ifndef WIFI_SSID
#define WIFI_SSID "YOUR_WIFI_SSID"
#endif
#ifndef WIFI_PASSWORD
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
#endif

// Laptop running CALT API (same LAN). UDP port must match EEG_UDP_PORT (default 5005).
#ifndef UDP_TARGET_IP
#define UDP_TARGET_IP "192.168.1.100"
#endif
#ifndef UDP_TARGET_PORT
#define UDP_TARGET_PORT 5005
#endif

// BioAmp EXG Pill → ESP32-S3 ADC-capable GPIO.
// Many S3 DevKit boards: GPIO 4 is safe. Avoid strapping pins.
#ifndef EEG_PIN
#define EEG_PIN 4
#endif

// MicroSD SPI (ESP32-S3 DevKitC defaults; override for your module)
#ifndef SD_CS_PIN
#define SD_CS_PIN 5
#endif
#ifndef SD_SCK_PIN
#define SD_SCK_PIN 12
#endif
#ifndef SD_MISO_PIN
#define SD_MISO_PIN 13
#endif
#ifndef SD_MOSI_PIN
#define SD_MOSI_PIN 11
#endif

// Features (1 = on, 0 = off) — all soft-fail if hardware missing
#ifndef ENABLE_WIFI
#define ENABLE_WIFI 1
#endif
#ifndef ENABLE_SD_LOGGING
#define ENABLE_SD_LOGGING 1
#endif
#ifndef ENABLE_UDP
#define ENABLE_UDP 1
#endif

#ifndef SAMPLE_RATE_HZ
#define SAMPLE_RATE_HZ 250
#endif

// 1 = inject snap-like pulses (no BioAmp needed) to verify WiFi→UDP→PC
// 0 = read BioAmp EXG Pill on EEG_PIN
#ifndef SELF_TEST_MODE
#define SELF_TEST_MODE 1
#endif
// Seconds between synthetic snaps in SELF_TEST_MODE
#ifndef SELF_TEST_SNAP_EVERY_S
#define SELF_TEST_SNAP_EVERY_S 2
#endif
