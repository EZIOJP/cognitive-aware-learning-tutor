{
  "manifest_version": 3,
  "name": "CALT SelfTracker (Edge / Chrome)",
  "version": "1.5.13",
  "description": "Tracks browsing; DNR + single-tab softLand; crash-safe (no 4s enforce); Jarvis caption.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "idle",
    "history",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "109",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CALT SelfTracker",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["locked.html", "gate_policy.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
