# Optional Studio-only overrides (repo root .env is the primary AI handler config)
# See ../.env.example and docs/LLM_GATEWAY.md for LLM_CLOUD_API_KEY + data/llm_tiers.json
LLM_ENABLED=1

# Provider "auto" (default) uses the repo AI handler — no Studio LLM keys required.
# LLM_PROVIDER=auto
# LLM_TIER=medium

# Manual override (bypasses tier chains):
# LLM_PROVIDER=lmstudio
# LLM_BASE_URL=http://127.0.0.1:1234
# LLM_MODEL=google/gemma-4-e4b

LLM_MAX_TOKENS=8192

# Whisper (GUI: Audio → Transcript) — still runs locally unless you use Live Captions
# WHISPER_ENGINE=transformers
# WHISPER_MODEL=openai/whisper-large-v3-turbo
